# ==============================================================================
# university-api-gateway (Node.js Express API Gateway) .gitignore
# ==============================================================================

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Environment variables & secrets (NEVER COMMIT API KEYS)
.env
.env.*
!.env.example
*.key
*.pem
*.pfx
*.p12
*.crt
credentials.json

# Logs
logs/
*.log

# Runtime files
pids/
*.pid
*.seed
*.pid.lock

# Build & test output
coverage/
.nyc_output/
dist/
build/

# Temporary files
tmp/
temp/

# IDE files
.vscode/
.idea/
*.iml

# OS files
.DS_Store
Thumbs.db
