# ==============================================================================
# university-lms-service (Spring Boot LMS Microservice) .gitignore
# ==============================================================================

# Compiled binaries and target directory
target/
*.class
*.jar
*.war
*.ear
*.nar

# Eclipse IDE
.metadata/
.project
.classpath
.settings/
bin/

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# VS Code
.vscode/

# Secrets & environment configurations
.env
.env.*
!.env.example
application-local.properties
application-secret.properties
*.key
*.pem

# Uploaded assignment submissions / temp files
uploads/
temp/
tmp/

# Logs
logs/
*.log

# OS generated files
.DS_Store
Thumbs.db
